# ── SQLite（默认，零配置）──
# 不设置 DATABASE_URL 即可，启动脚本自动使用 SQLite
# 数据文件保存在 backend/data/tracesession.db

# ── PostgreSQL（生产环境）──
# 取消注释并填写你的连接串：
# DATABASE_URL="postgresql://user:password@host:5432/tracesession"

# ── 端口（可选，默认 27890/27891）──
# HTTP_PORT=27890
# HTTPS_PORT=27891

# Security
# Set this when the backend is reachable from another machine.
# Remote writes and mod polling should send x-tracesession-key with the same value.
# TRACESESSION_API_KEY=change-this-long-random-key
# TRACESESSION_CORS_ORIGINS=http://localhost:27892,https://panel.example.com
# TRACESESSION_REQUIRE_API_KEY_FOR_READS=false
# TRACESESSION_ENABLE_DEBUG_API=false

# Outbound Webhook: game/server -> external systems
# Fill one or more receiving URLs separated by commas.
# When Minecraft chat or game events arrive, the backend will POST JSON to these URLs.
# OUTBOUND_WEBHOOK_URLS=https://example.com/tracesession/webhook,https://bot.example.com/minecraft
