generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model Server {
  id            String    @id @default(uuid())
  name          String
  address       String
  status        String    @default("offline")
  note          String    @default("")
  lastHeartbeat DateTime?
  tps           Float?
  mtps          Float?
  gameMode      String?
  modLoader     String?
  modVersion    String?
  gameVersion   String?
  firstSeen     DateTime  @default(now())
  sessions      Session[]
  events        Event[]
  snapshots     PlayerSnapshot[]
}

model Player {
  uuid      String    @id
  name      String
  firstSeen DateTime  @default(now())
  lastSeen  DateTime  @default(now())
  sessions  Session[]
  events    Event[]
  snapshots PlayerSnapshot[]
}

model Session {
  id              String    @id @default(uuid())
  playerUuid      String
  serverId        String
  joinTime        DateTime
  leaveTime       DateTime?
  durationSeconds Int?
  player          Player    @relation(fields: [playerUuid], references: [uuid])
  server          Server    @relation(fields: [serverId], references: [id])

  @@index([playerUuid])
  @@index([serverId])
  @@index([joinTime])
}

model Event {
  id         String   @id @default(uuid())
  playerUuid String
  serverId   String
  type       String
  timestamp  DateTime @default(now())
  player     Player   @relation(fields: [playerUuid], references: [uuid])
  server     Server   @relation(fields: [serverId], references: [id])

  @@index([playerUuid])
  @@index([serverId])
  @@index([timestamp])
  @@index([type])
}

model PlayerSnapshot {
  id              String   @id @default(uuid())
  playerUuid      String
  serverId        String
  timestamp       DateTime @default(now())
  name            String
  dimension       String?
  x               Int?
  y               Int?
  z               Int?
  health          Float?
  maxHealth       Float?
  foodLevel       Int?
  experienceLevel Int?
  gameMode        String?
  latency         Int?
  player          Player   @relation(fields: [playerUuid], references: [uuid])
  server          Server   @relation(fields: [serverId], references: [id])

  @@index([playerUuid])
  @@index([serverId])
  @@index([timestamp])
}
